{
  "name": "voice-agent",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "scenario:bountywell": "pnpm --filter @voice-agent/scenario test --run",
