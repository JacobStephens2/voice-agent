[Unit]
Description=Resume the Voice Agent Promotion queue after a Fresh Passkey Action
After=network-online.target
Wants=network-online.target
# Recovery must never refuse to start. Under the default start limit, repeated
# Fresh Passkey Actions can rate-limit this unit into a state that blocks its
# own path trigger until a root terminal runs systemctl reset-failed — exactly
# when the Deployment Circuit Breaker is open and the owner needs it. The
# request file is consumed before any build, and a resumed failure is recorded
# without counting, so the script bounds repetition instead.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
LoadCredential=github-app-key:/etc/voice-agent/github-app-private-key.pem
Environment=VOICE_AGENT_GITHUB_APP_KEY_PATH=%d/github-app-key
ExecStart=/usr/local/libexec/voice-agent/resume-promotion.sh
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHome=true
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/etc/systemd/system /opt/voice-agent /var/lib/voice-agent /var/lib/voice-agent-broker /var/lib/voice-agent-builder /var/lib/voice-agent-promotions /var/lib/voice-agent-promotion-resume /var/lib/voice-agent-source /run
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
