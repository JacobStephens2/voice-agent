[Unit]
Description=Voice Agent bounded application and API probes
After=network-online.target voice-agent-api.service voice-agent-worker.service voice-agent-broker.service
Wants=network-online.target

[Service]
Type=oneshot
User=voice-broker
Group=voice-broker
SupplementaryGroups=voice-broker-client
WorkingDirectory=/opt/voice-agent/current
Environment=NODE_ENV=production
Environment=VOICE_AGENT_BROKER_SOCKET_PATH=/run/voice-agent-broker/broker.sock
Environment=VOICE_AGENT_PROBE_METRICS_PATH=/var/lib/voice-agent-probes/probes.prom
ExecStart=/usr/bin/node --experimental-strip-types /opt/voice-agent/current/apps/broker/src/probe-metrics-cli.ts
UMask=0022
StateDirectory=voice-agent-probes
StateDirectoryMode=0755
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/voice-agent-probes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
