[Unit]
Description=Root-owned typed Keeplore GitHub App publisher
After=network-online.target
Wants=network-online.target
Before=voice-agent-subagent.service

[Service]
Type=simple
User=root
Group=voice-subagent-client
SupplementaryGroups=voice-agent
WorkingDirectory=/usr/local/libexec/voice-agent
Environment=NODE_ENV=production
Environment=VOICE_AGENT_DATABASE_PATH=/var/lib/voice-agent/voice-agent.sqlite
Environment=VOICE_AGENT_KEEPLORE_PUBLISHER_SOCKET_PATH=/run/voice-agent-keeplore-publisher/publisher.sock
Environment=KEEPLORE_REPOSITORY_POLICY_JOURNAL=/var/lib/keeplore-promotions/repository-policy.jsonl
Environment=KEEPLORE_GITHUB_APP_CONFIGURATION=%d/keeplore-github-app-config
Environment=KEEPLORE_GITHUB_APP_KEY_PATH=%d/keeplore-github-app-key
LoadCredential=keeplore-github-app-config:/etc/voice-agent/keeplore-github-app.conf
LoadCredential=keeplore-github-app-key:/etc/voice-agent/keeplore-github-app-private-key.pem
# Empty defaults let the publisher stay healthy before Keeplore onboarding;
# absolute LoadCredential sources override them as soon as they exist.
SetCredential=keeplore-github-app-config:
SetCredential=keeplore-github-app-key:
ExecStart=/usr/bin/node --experimental-strip-types /usr/local/libexec/voice-agent/keeplore-github-app-publisher.ts
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
UMask=0007
RuntimeDirectory=voice-agent-keeplore-publisher
RuntimeDirectoryMode=0750
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/var/lib/voice-agent -/var/lib/keeplore-promotions
ReadWritePaths=/var/lib/voice-agent-worktrees/keeplore.git /var/lib/voice-agent-worktrees/keeplore
InaccessiblePaths=/var/lib/voice-codex /var/lib/voice-agent-broker /var/www /opt/keeplore /run/voice-agent-broker /run/docker.sock /var/run/docker.sock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
