[Unit]
Description=Voice Agent telephone and durable background runtime
After=network-online.target voice-agent-broker.service voice-agent-subagent.service
Requires=voice-agent-broker.service voice-agent-subagent.service
Wants=network-online.target

[Service]
Type=simple
User=voice-agent
Group=voice-agent
SupplementaryGroups=voice-broker-client voice-subagent-client
WorkingDirectory=/opt/voice-agent/current
Environment=NODE_ENV=production
Environment=VOICE_AGENT_DATABASE_PATH=/var/lib/voice-agent/voice-agent.sqlite
Environment=VOICE_AGENT_BROKER_SOCKET_PATH=/run/voice-agent-broker/broker.sock
Environment=VOICE_AGENT_SUBAGENT_SOCKET_PATH=/run/voice-agent-subagent/runner.sock
Environment=VOICE_AGENT_WORKER_PORT=3474
# A Recognized Synthesis Model and the voice it speaks in. The code defaults
# already match these values; they are written out because an operator working
# an outage reads the unit, not the source. An unrecognized model, or a model
# left with no voice, ends this service at start.
Environment=VOICE_AGENT_TTS_MODEL=inworld/inworld-tts-2
Environment=VOICE_AGENT_TTS_VOICE=Sarah
# A Recognized Speech Model. The code default already matches this value; it is
# written out because an operator working an outage reads the unit, not the
# source. An unrecognized value ends this service at start.
Environment=VOICE_AGENT_STT_MODEL=assemblyai/universal-streaming-multilingual
Environment=VOICE_AGENT_PROLONGED_SILENCE_SECONDS=60
Environment=VOICE_AGENT_RAW_AUDIO_DEBUG_DIRECTORY=/var/lib/voice-agent/raw-audio-debug
# Conservative budget-accounting rates; provider-specific overrides belong in livekit.env.
Environment=VOICE_AGENT_API_MICROUSD_PER_MINUTE=50000
Environment=VOICE_AGENT_TELEPHONY_MICROUSD_PER_MINUTE=50000
Environment=VOICE_AGENT_REALTIME_MEDIA_MICROUSD_PER_MINUTE=100000
EnvironmentFile=/etc/voice-agent/livekit.env
EnvironmentFile=/etc/voice-agent/resend.env
EnvironmentFile=-/etc/voice-agent/keeplore-delegation.env
ExecStart=/usr/bin/node --experimental-strip-types /opt/voice-agent/current/apps/worker/src/server.ts
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/voice-agent
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
