[Unit]
Description=Voice Agent restricted Codex Subagent Runner
After=network-online.target voice-agent-keeplore-publisher.service
Requires=voice-agent-keeplore-publisher.service
Wants=network-online.target

[Service]
Type=simple
User=voice-codex
Group=voice-subagent-client
WorkingDirectory=/opt/voice-agent/current
Environment=NODE_ENV=production
Environment=VOICE_AGENT_SUBAGENT_SOCKET_PATH=/run/voice-agent-subagent/runner.sock
Environment=VOICE_AGENT_KEEPLORE_PUBLISHER_SOCKET_PATH=/run/voice-agent-keeplore-publisher/publisher.sock
Environment=VOICE_AGENT_CODEX_EXECUTOR=/opt/voice-agent/current/ops/subagent/run-keeplore-codex-delegation
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/voice-codex/.cache/ms-playwright
ExecStart=/usr/bin/node --experimental-strip-types /opt/voice-agent/current/apps/worker/src/subagent-server.ts
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
UMask=0007
RuntimeDirectory=voice-agent-subagent
RuntimeDirectoryMode=0770
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/var/lib/keeplore-source
ReadWritePaths=/var/lib/voice-codex /var/lib/voice-agent-worktrees/keeplore /var/lib/voice-agent-worktrees/keeplore.git /var/lib/voice-agent-evidence
InaccessiblePaths=/var/lib/voice-agent /var/lib/voice-agent-broker /var/www /opt/keeplore /run/voice-agent-broker /run/docker.sock /var/run/docker.sock
# AF_NETLINK is Bubblewrap's, not the runner's: with the model sandbox's
# network disabled, bwrap unshares the network namespace and brings up loopback
# inside it, which needs a NETLINK_ROUTE socket. Without this the sandbox dies
# in setup and the model reads nothing. The sandbox still has no network.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Restricted Codex runs the model workspace inside Bubblewrap, which asks the
# kernel for CLONE_NEWUSER|CLONE_NEWNS in one clone call. systemd's namespace
# seccomp filter matches that whole mask, so restricting any single namespace
# type denies the sandbox outright and every Delegation fails before the model
# reads a file. The namespace boundary is held instead by the reviewed enforcing
# AppArmor bwrap and unpriv_bwrap profiles, which deny capabilities inside the
# child, with kernel.apparmor_restrict_unprivileged_userns=1.
RestrictNamespaces=false
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
