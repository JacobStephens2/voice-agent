[Unit]
Description=Voice Agent bounded Grok contract Delegation %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=voice-grok
Group=voice-grok
WorkingDirectory=/opt/voice-agent/current
Environment=NODE_ENV=production
ExecStart=/opt/voice-agent/current/ops/subagent/run-grok-contract-delegation %i
TimeoutStopSec=30s
# Stopping is a first-class ending: the executor terminates the model's process
# group, records a stopped outcome, and leaves the Delegation root untouched.
KillMode=mixed
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
# The model process must not be able to read this executor's memory to reach
# the access token the runner holds.
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/voice-grok /var/lib/voice-agent-evidence
# The subset of the Credential Custody Boundary this whole unit can hide.
#
# The executor needs /etc/voice-agent/grok, /var/lib/voice-agent-evidence, and
# /usr/local/libexec/voice-agent, but the model shares its identity and the
# current sandbox denies none of them. Their child-only boundary is unresolved;
# omission here is not evidence that model-selected tools cannot reach them.
InaccessiblePaths=/root /run/voice-agent-broker /run/voice-agent-grok-auth /run/voice-agent-keeplore-publisher /run/voice-agent-subagent /var/lib/voice-agent /var/lib/voice-agent-broker /var/lib/voice-codex /var/lib/voice-grok-auth /var/www /opt/keeplore /run/docker.sock /var/run/docker.sock
# AF_NETLINK remains available for Bubblewrap. AF_INET and AF_INET6 also mean
# this unit does not supply the unresolved child-process network restriction.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Bubblewrap asks the kernel for CLONE_NEWUSER|CLONE_NEWNS in one clone call,
# which systemd's namespace filter matches as a whole. The namespace boundary
# is held instead by the reviewed enforcing AppArmor bwrap profiles with
# kernel.apparmor_restrict_unprivileged_userns=1.
RestrictNamespaces=false
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
