[Unit]
Description=Voice Agent bounded Grok contract Delegation %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=voice-grok
Group=voice-grok
WorkingDirectory=/opt/voice-agent/current
Environment=NODE_ENV=production
ExecStart=/opt/voice-agent/current/ops/subagent/run-grok-contract-delegation %i
TimeoutStopSec=30s
# Stopping is a first-class ending: the executor terminates the model's process
# group, records a stopped outcome, and leaves the Delegation root untouched.
KillMode=mixed
KillSignal=SIGTERM
UMask=0077
# The sudoers Auth Crossing needs setuid sudo to become euid 0, then CAP_SETUID
# and CAP_SETGID to become voice-grok-auth. NoNewPrivileges would stop that
# before sudoers is evaluated. Do not run this unit as root; if sudo/PAM on the
# host needs one more cap, the attended canary records it.
NoNewPrivileges=false
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
# The model process must not be able to read this executor's memory to reach
# the access token the runner holds.
ProtectProc=invisible
ProtectSystem=strict
# /var/lib/voice-grok-auth stays 0700 voice-grok-auth, so voice-grok still
# cannot read the store. The helper must write it on renewal (ADR-0069), and a
# UID change cannot escape InaccessiblePaths, so the path is writable here
# rather than hidden from the whole unit.
ReadWritePaths=/var/lib/voice-grok /var/lib/voice-agent-evidence /var/lib/voice-grok-auth
# Credential Custody Boundary stores this unit can hide from every process in
# its namespace. The Auth Crossing directory is not among them: the parent
# runner must execute the broker. Child AppArmor, not this list, denies the
# crossing to model-selected Bubblewrap children.
InaccessiblePaths=/root /run/voice-agent-broker /run/voice-agent-grok-auth /run/voice-agent-keeplore-publisher /run/voice-agent-subagent /var/lib/voice-agent /var/lib/voice-agent-broker /var/lib/voice-codex /var/www /opt/keeplore /run/docker.sock /var/run/docker.sock
# AF_NETLINK remains available for Bubblewrap. AF_INET and AF_INET6 also mean
# this unit does not supply the unresolved child-process network restriction.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Bubblewrap asks the kernel for CLONE_NEWUSER|CLONE_NEWNS in one clone call,
# which systemd's namespace filter matches as a whole. The namespace boundary
# is held instead by the reviewed enforcing AppArmor bwrap profiles with
# kernel.apparmor_restrict_unprivileged_userns=1.
RestrictNamespaces=false
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
