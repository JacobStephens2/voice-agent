[Unit]
Description=Voice Agent bounded Grok contract Delegation %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=voice-grok
Group=voice-grok
WorkingDirectory=/opt/voice-agent/current
Environment=NODE_ENV=production
ExecStart=/opt/voice-agent/current/ops/subagent/run-grok-contract-delegation %i
TimeoutStopSec=30s
# Stopping is a first-class ending: the executor terminates the model's process
# group, records a stopped outcome, and leaves the Delegation root untouched.
KillMode=mixed
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
# The model process must not be able to read this executor's memory to reach
# the access token the runner holds.
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/voice-grok /var/lib/voice-agent-evidence
# The Credential Custody Boundary, held by the host as well as by the sandbox.
# Losing one of these paths from the reviewed sandbox profile must not be
# enough to disclose a credential.
#
# Two boundary stores are absent here on purpose. The executor itself reads
# /etc/voice-agent/grok for the reviewed runner pin and root-managed
# configuration, and writes its durable record under /var/lib/voice-agent-
# evidence. Neither is readable by the model: the reviewed sandbox profile
# denies both to model-selected tools, and ProtectSystem=strict keeps /etc
# read-only for the executor.
InaccessiblePaths=/root /run/voice-agent-broker /run/voice-agent-grok-auth /run/voice-agent-keeplore-publisher /run/voice-agent-subagent /var/lib/voice-agent /var/lib/voice-agent-broker /var/lib/voice-codex /var/lib/voice-grok-auth /var/www /opt/keeplore /run/docker.sock /var/run/docker.sock
# AF_NETLINK is Bubblewrap's, not the runner's: with the model sandbox's
# network restricted, bwrap unshares the network namespace and brings up
# loopback inside it, which needs a NETLINK_ROUTE socket. The sandbox still has
# no child-process network.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Bubblewrap asks the kernel for CLONE_NEWUSER|CLONE_NEWNS in one clone call,
# which systemd's namespace filter matches as a whole. The namespace boundary
# is held instead by the reviewed enforcing AppArmor bwrap profiles with
# kernel.apparmor_restrict_unprivileged_userns=1.
RestrictNamespaces=false
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
