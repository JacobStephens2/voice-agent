#!/usr/bin/env bash
#
# The auth provider Grok Build invokes: one short-lived access token, on
# standard output, from the identity that owns the refresh credential.
#
# Installed at /usr/local/libexec/voice-agent/grok-token-broker, owned by root,
# mode 0755. The runner runs as voice-grok and cannot read the credential
# itself; this is the only crossing, and the sudoers rule beside it permits
# exactly this one command with no arguments.
#
# The model's sandbox denies /usr/local/libexec/voice-agent, so a
# model-selected command cannot invoke this broker even though the runner it
# runs under just did.
set -euo pipefail

exec /usr/bin/sudo -n -u voice-grok-auth \
  /usr/local/libexec/voice-agent/grok-token-helper
