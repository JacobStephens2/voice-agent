#!/usr/bin/env bash
#
# The auth provider Grok Build invokes: one short-lived access token, on
# standard output, from the identity that owns the refresh credential. With
# `--probe` it asks the same identity whether there is a credential to run on
# and returns only a status, which is how the fixed executor establishes that a
# Delegation has one before it spawns a model.
#
# Installed at /usr/local/libexec/voice-agent/grok-token-broker, owned by root,
# mode 0755, inside a root-owned /usr/local/libexec/voice-agent directory with
# mode 0755 so the voice-grok executor can traverse it. The runner cannot read
# the credential itself; this is the only crossing, and the sudoers rules
# beside it permit exactly these two commands and no other argument.
#
# The current model sandbox does not deny /usr/local/libexec/voice-agent, and
# model-selected commands share the runner's voice-grok identity. ADR-0068's
# intended parent/child split is therefore held for a compensating boundary;
# installing this crossing alone is not a Credential Custody Boundary witness.
set -euo pipefail

readonly HELPER=/usr/local/libexec/voice-agent/grok-token-helper

# -H so the helper resolves the custody identity's own Grok home rather than
# whichever HOME the caller happened to be running under.
if [[ $# -eq 0 ]]; then
  exec /usr/bin/sudo -n -H -u voice-grok-auth "$HELPER"
fi
if [[ $# -eq 1 && "$1" == "--probe" ]]; then
  exec /usr/bin/sudo -n -H -u voice-grok-auth "$HELPER" --probe
fi
echo "grok-token-broker takes no argument, or --probe" >&2
exit 1
