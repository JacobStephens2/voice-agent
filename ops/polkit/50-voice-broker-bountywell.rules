// Narrow voice-broker authority for the Bountywell Outage Drill.
// Installed by ops/acceptance/run-bountywell-outage-drill.sh onto the Agent Host.
// Not loaded from a candidate Release.
//
// Do not grant org.freedesktop.systemd1.manage-unit-files. On systemd 255 /
// polkit 124 that action authorizes StartUnit, so a blanket YES lets
// voice-broker start arbitrary units (including apache2.service).

polkit.addRule(function (action, subject) {
    if (subject.user != "voice-broker") {
        return polkit.Result.NOT_HANDLED;
    }

    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";
    var allowedUnits = {
        "bountywell-api.service": true,
        "bountywell-api-recovery.service": true,
        "bountywell-api-recovery.timer": true
    };

    if (action.id == "org.freedesktop.systemd1.manage-units") {
        if (allowedUnits[unit] === true && (verb == "start" || verb == "stop")) {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }

    return polkit.Result.NOT_HANDLED;
});
