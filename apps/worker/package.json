    "@voice-agent/runtime": "workspace:*",
    "@voice-agent/sqlite-store": "workspace:*",
    "livekit-server-sdk": "2.17.0",
    "playwright": "1.62.1",
    "resend": "6.20.0",
    "zod": "4.4.3"
